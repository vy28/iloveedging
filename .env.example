# Copy to .env and fill in. Never commit .env.

# --- Slips session (required for live terminal / scan) --- see README "Getting your Slips tokens"
SLIPS_ACCESS_TOKEN=
SLIPS_REFRESH_TOKEN=

# --- What counts as an opportunity ---
# Polymarket probability minus Slips probability (0.08 = 8 percentage points)
EDGE_THRESHOLD=0.08
# Minimum expected profit per $1 spent on Slips, after the fee and your own bet moving the odds (0.05 = +5%)
MIN_EV=0.05
# How much you'd bet, in dollars
BET_SIZE=10
# Skip pools with less than this much money on the other side (the most you can win)
MIN_OPPOSING_MONEY=25
# Skip Polymarket games with less volume than this, or a wider bid/ask spread
MIN_POLY_VOLUME=1000
MAX_POLY_SPREAD=0.05
LOOKAHEAD_DAYS=10
LEAGUES=nfl,nba,mlb,nhl,wnba,cfb,cbb,mls,epl,ufc

# --- Alerts (all optional; console output is always on) ---
MACOS_NOTIFICATIONS=0
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
